resource "aws_cloudwatch_event_rule" "event_rule" {
  name        = "my-event-rule"
  description = "Event rule to run a Lambda function daily"
  event_pattern = jsonencode({
    source      = ["aws.lambda"]
    detail-type = ["Lambda Function Execution"]
    detail      = {
      function-name = ["my-lambda-function"]
    }
  })
  state = "ENABLED"
}

resource "aws_cloudwatch_event_target" "event_target" {
  name            = "my-event-target"
  description     = "Event target to invoke a Lambda function"
